#topbar {
    height: 1;
    background: $panel;
    padding: 0 1;
}

#crumb {
    width: 1fr;
    text-style: bold;
}

#alert {
    width: auto;
    color: $warning;
}

#views, #repos, #repo {
    height: 1fr;
}

#repo-list {
    height: auto;
    max-height: 1fr;
    border: none;
}

#empty {
    height: auto;
    padding: 1 2;
    color: $text-muted;
}

/* No repos at all: the message alone, in the middle. */
#empty.alone {
    height: 1fr;
    width: 1fr;
    content-align: center middle;
    text-align: center;
}

#legend {
    padding: 1 2 0 2;
    height: auto;
    color: $text-muted;
}

#main {
    height: 1fr;
}

/* The two panes (the diff takes the list's place); the focused one's border lights up. */
#prs-pane, #diff-pane, #session {
    border: round $foreground 25%;
    border-title-color: $text-muted;

    &:focus-within {
        border: round $accent;
        border-title-color: $accent;
        border-title-style: bold;
    }
}

#prs-pane, #diff-pane {
    width: 55%;
    min-width: 60;
}

#diff-pane.-wide {  /* zoomed: the PR's pane is away */
    width: 1fr;
}

#search {
    height: 3;
    border: round $accent;
    padding: 0 1;
    margin: 0 0 1 0;
    background: $boost;
}

#prs {
    height: 1fr;
    border: none;
    text-wrap: nowrap;
    text-overflow: ellipsis;

    /* Group headings are disabled options; keep them readable. */
    & > .option-list--option-disabled {
        color: $foreground;
    }
}

#session {
    width: 1fr;
}

#pr-header {
    height: auto;
    padding: 0 1 1 1;
}

#transcript {
    height: 1fr;
    margin: 0 0 1 1;  /* a blank line above the decision box and prompt */
    overflow-x: hidden;
    scrollbar-size-vertical: 1;
}

#working {
    height: 1;
    margin: 0 0 1 1;
}

#pr-decision {
    height: auto;
    margin: 0 1;
    padding: 0 1;
    border: round $warning;
}

#suggestions {
    height: auto;
    max-height: 10;
    margin: 0 1;
    border: none;
    background: $panel;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#prompt {
    margin: 0 1;
    height: auto;
    min-height: 3;
    max-height: 12;
}

AddRepoScreen, ConfirmScreen, RecapScreen, InstructionsScreen, HistorySearchScreen,
NoticeScreen, AlwaysScreen, ReviewSkillScreen, ThemeScreen {
    align: center middle;
}

#recap {
    width: 90;
    max-height: 90%;
}

#recap-headline {
    margin: 1 0;
}

#recap-items {
    height: auto;
    max-height: 12;
    border: none;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#recap-raw {
    height: auto;
    max-height: 10;
    margin: 1 0;
}

.dialog {
    width: 64;
    height: auto;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

.dialog Input {
    margin: 1 0 0 0;
}

.dialog #error {
    height: auto;
    margin: 0 0 1 0;
}

.hint {
    color: $text-muted;
}

#history {
    width: 90;
}

#review-skill {
    width: 84;
}

#review-skill-items {
    height: auto;
    max-height: 20;
    margin: 1 0;
    border: none;
}

#history-items {
    height: auto;
    max-height: 16;
    margin: 1 0 0 0;
    border: none;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
